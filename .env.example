# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGINS=https://admin-garbage.ivan-martinez.org,http://localhost:3000

# ── Database (PostgreSQL + PostGIS) ──────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=garbagetrack
DB_SSL=require

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-this-to-a-random-string
WHATSAPP_API_VERSION=v19.0
# Meta App Secret (App dashboard -> Settings -> Basic). When set, incoming
# webhooks must carry a valid X-Hub-Signature-256 or they are rejected (403).
# When empty, signature verification is DISABLED (a warning is logged).
META_APP_SECRET=

# ── Google Maps ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Asistente IA (Gemini) ─────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=1024
# Thinking level: minimal | low | medium | high.
GEMINI_THINKING_LEVEL=low
