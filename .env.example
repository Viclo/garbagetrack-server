# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGINS=https://admin-garbage.ivan-martinez.org,http://localhost:3000

# ── Database (PostgreSQL + PostGIS) ──────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=garbagetrack
DB_SSL=require

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Google Maps ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Asistente IA (Gemini) ─────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=1024
# Thinking level: minimal | low | medium | high.
GEMINI_THINKING_LEVEL=low

# ── Web Push (VAPID) ──────────────────────────────────────────
# Generate a pair with:  npx web-push generate-vapid-keys
# Public key is exposed to the resident PWA; keep the private key secret.
# When unset, Web Push is disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@garbagetrack.app
